# Obligatorias
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.neon.tech/neondb?sslmode=require
MINATO_SECRET=cambia-esto-por-un-secreto-largo

# Opcionales
PORT=3000
HOST=0.0.0.0
MINATO_DATA_DIR=./data
# 1 si estás detrás de un proxy que envía x-forwarded-for (para el límite de intentos fallidos)
MINATO_TRUST_PROXY=0
# Nodos remotos (otros Minato Hub). Se usan con target_node=<nombre>
# MINATO_NODES={"vps2":{"url":"https://hub2.ejemplo.com","token":"SECRETO_DEL_HUB_2"}}
